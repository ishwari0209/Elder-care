
{
  "expo": {
    "name": "saathi-mobile",
    "slug": "saathi-mobile",
    "version": "1.0.0",
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/routine_en.wav",
            "./assets/sounds/routine_hi.wav",
            "./assets/sounds/routine_mr.wav",
            "./assets/sounds/medicine_en.wav",
            "./assets/sounds/medicine_hi.wav",
            "./assets/sounds/medicine_mr.wav"
          ]
        }
      ],
      "expo-speech-recognition",
      "expo-video",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Saathi uses the camera to read your prescription on your phone. The photo is never uploaded."
        }
      ]
    ],
    "android": {
      "package": "com.anonymous.saathimobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "eb83bfe0-92b7-498c-9497-9445019eac9b"
      }
    },
    "scheme": "saathi"
  }
}
